# Copy to .env locally; NEVER commit real secrets.
# Generation is disabled until you deliberately enable it.
VIDEO_GENERATION_ENABLED=false
HF_TOKEN=
# Select a model/provider combination supported by your Hugging Face account.
VIDEO_MODEL=Wan-AI/Wan2.2-TI2V-5B
VIDEO_PROVIDER=fal-ai
# A text-to-video inference request may consume credits or incur charges.
# Review current provider pricing and account billing before enabling.
MAX_VIDEO_BYTES=52428800
OUTPUT_DIR=generated
